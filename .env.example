# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Dashboard --------------------------------------------------------------
SECRET_KEY=change-this-to-a-random-string
# If set, only logged-in admins can change keywords/journals or trigger runs.
ADMIN_PASSWORD=
SITE_NAME=Paper Pulse

# --- Agent ------------------------------------------------------------------
CLAUDE_MODEL=claude-opus-5-5
# Cheaper model for the abstract screening pass (optional), e.g. claude-haiku-5-5
SCREEN_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
# Server-side refusal fallback (Claude API only). Set 0 on Bedrock/Vertex/Foundry.
CLAUDE_FALLBACKS=1

# Defaults for the pipeline (all editable later on the settings page)
FETCH_INTERVAL_HOURS=6
LOOKBACK_DAYS=3
MAX_PER_SOURCE=40
MAX_FULL_READS=5
MIN_RELEVANCE=6

# --- Data sources -----------------------------------------------------------
# Your email for OpenAlex's polite pool (faster, more reliable)
OPENALEX_MAILTO=you@example.com
SEMANTIC_SCHOLAR_API_KEY=

# --- Google Drive (optional) -------------------------------------------------
GDRIVE_FOLDER_ID=
# Option A: service account JSON (folder must be in a Shared Drive it can access)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Option B: OAuth desktop client JSON, then run: python -m paperagent drive-auth
GOOGLE_OAUTH_CLIENT_FILE=

# --- Card news ----------------------------------------------------------------
CARD_BRAND=PAPER PULSE
CARD_HANDLE=@paper.pulse
CARD_OUTRO_LINES=READ,PAPERS,AS FAST AS,POSSIBLE
# Only if Playwright can't find Chromium on its own
CHROMIUM_EXECUTABLE=
