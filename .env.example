# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Dashboard --------------------------------------------------------------
SECRET_KEY=change-this-to-a-random-string
# If set, only logged-in admins can change keywords/journals or trigger runs.
ADMIN_PASSWORD=
SITE_NAME=STAR WARS

# --- Agent: one model per job ------------------------------------------------
# Reads the full PDF (largest input) -> cheapest model
READER_MODEL=claude-haiku-5-5
# Scores methodology and novelty from the reader's notes -> strongest model
JUDGE_MODEL=claude-opus-5-5
# Writes the Korean review and card copy
WRITER_MODEL=claude-sonnet-5-5
# Rates abstracts for relevance
SCREEN_MODEL=claude-haiku-5-5
JUDGE_EFFORT=high
READER_EFFORT=low
WRITER_EFFORT=low
# Server-side refusal fallback (Claude API only). Set 0 on Bedrock/Vertex/Foundry.
CLAUDE_FALLBACKS=1

# Defaults for the pipeline (all editable later on the settings page)
FETCH_INTERVAL_HOURS=12
LOOKBACK_DAYS=3
MAX_PER_SOURCE=40
MAX_FULL_READS=3
MIN_RELEVANCE=7

# --- Database / storage (set automatically on Heroku) -------------------------
# Leave empty to use a local SQLite file under data/. On Heroku, the Postgres
# add-on sets DATABASE_URL and images are then stored in the database.
DATABASE_URL=
# local | db  (defaults to db whenever DATABASE_URL is set)
STORAGE_BACKEND=

# --- Data sources -----------------------------------------------------------
# Your email for OpenAlex's polite pool (faster, more reliable)
OPENALEX_MAILTO=you@example.com
SEMANTIC_SCHOLAR_API_KEY=

# --- Card news ----------------------------------------------------------------
CARD_BRAND=STAR WARS
CARD_HANDLE=@starwars.research
BRAND_TAGLINE=Smart Topic Analysis & Rating · Worthwise Article Research System
# Only if Playwright can't find Chromium on its own
CHROMIUM_EXECUTABLE=
